# 🛡️ DineSphere Environment Variables Template

# 1. Django Security
# Important: Generate a unique secret key for your local setup
SECRET_KEY=django-insecure-local-dev-key-change-me-in-production
DEBUG=True

# 2. Database Configuration
# Default is SQLite (local db.sqlite3)
# Set USE_MONGO=True if you have MongoDB installed and running
USE_MONGO=False
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=DineSphere

# 3. Email Configuration (SMTP - e.g., Brevo)
# Note: These are required for the Reservation & Invoice system to send emails!
EMAIL_HOST_USER=your_smtp_user_here
EMAIL_HOST_PASSWORD=your_smtp_password_here
DEFAULT_FROM_EMAIL=your_verified_sender_email@example.com

# 4. Location Settings
TIME_ZONE=Asia/Karachi
